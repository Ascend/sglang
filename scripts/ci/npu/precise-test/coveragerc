[run]
branch = True
relative_files = False
parallel = True
concurrency = thread,multiprocessing
# Subprocess coverage (server/scheduler/detokenizer) relies on this:
# scheduler and detokenizer have no SIGTERM handler of their own, so the
# coverage handler installed at process_startup() is what flushes their
# data when the teardown SIGTERMs the tree before SIGKILL escalation.
sigterm = True
disable_warnings = no-data-collected,module-not-python

# PERF NOTE (full-test #1481): subprocess coverage slows Python-dense
# weight-load paths (GGUF dequant, torch_npu CPU dtype conversion) by ~10-50x
# (75MB/s vs 3.5GB/s warm), pushing server launches past the health-check
# timeout. Setting branch=False roughly halves the per-line trace work if
# launch-timeout regressions persist; kept True here to preserve the
# branch-coverage semantics the precise-test mapping relies on.
# branch = False

include =
    */python/sglang/*

omit =
    */.local/*
    /usr/*
